# Production Backend URL (Render FastAPI Service)
# When deploying to Vercel, set this in your Vercel Project Settings > Environment Variables
FASTAPI_URL=https://runwise-api.onrender.com

# Public Demo Mode ('replay' serves genuine benchmark replays with zero cloud cost)
NEXT_PUBLIC_DEMO_MODE=replay

# Public Site Domain
NEXT_PUBLIC_SITE_URL=https://runwise.vercel.app
