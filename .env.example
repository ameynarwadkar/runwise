# Provider Selection ('vertex' or 'gemini')
LLM_PROVIDER=vertex

# Google Cloud Vertex AI Configuration (ADC Authenticated via `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
VERTEX_MODEL=gemini-2.5-flash

# Gemini Developer API (Alternative fallback)
GEMINI_API_KEY=

# Evaluation & Observability Settings
CACHE_MODE=off
LOG_LEVEL=INFO
